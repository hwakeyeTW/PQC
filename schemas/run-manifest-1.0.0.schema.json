      "maxLength": 40,
      "minLength": 1,
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
      "type": "string"
    },
    "recovery": {
      "type": "boolean"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "rule_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])$(?![\\s\\S])"
      },
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,63})$(?![\\s\\S])",
      "type": "string"
    },
    "run_kind": {
      "enum": [
        "NATIVE_SCAN",
        "LEGACY_IMPORT",
        "SYNTHETIC"
      ],
      "type": "string"
    },
    "run_state": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "ERROR"
      ],
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "manifest_version",
    "publication_state",
    "run_id",
    "run_kind",
    "run_state",
    "reason_code",
    "recovery",
    "source",
    "started_at",
    "finished_at",
    "recorded_at",
    "expected_host_ids",
    "hosts",
    "counts",
    "limits",
    "profile",
    "flags",
    "requirements",
    "evidence_schema_version",
    "rule_version",
    "rules_sha256",
    "batch_rc",
    "batch_contract",
    "batch_canonical_sha256",
    "batch_missing_reason",
    "artifacts",
    "missing_artifacts"
  ],
  "title": "PQC Run Store manifest",
  "type": "object"
}
