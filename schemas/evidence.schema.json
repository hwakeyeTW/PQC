{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pqc:evidence:1.0.0",
  "$ref": "#/$defs/document",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "producer_id",
        "producer_version",
        "origin_ref",
        "input_sha256"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "NATIVE_COLLECTOR",
            "LEGACY_IMPORT",
            "SYNTHETIC"
          ]
        },
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "producer_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "input_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "family",
        "primitive",
        "observed_name",
        "taxonomy_version"
      ],
      "properties": {
        "algorithm_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "type": "string",
          "enum": [
            "CLASSICAL",
            "PQC",
            "HYBRID",
            "UNKNOWN"
          ]
        },
        "primitive": {
          "type": "string",
          "enum": [
            "KEM",
            "KEX",
            "SIGNATURE",
            "PUBLIC_KEY",
            "SYMMETRIC",
            "UNKNOWN"
          ]
        },
        "observed_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 66,
              "pattern": "^(?:a-[0-9a-f]{64})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_state",
        "recorded_at",
        "started_at",
        "finished_at",
        "source",
        "expected_host_ids"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,63})$(?![\\s\\S])"
        },
        "run_state": {
          "type": "string",
          "enum": [
            "PLANNED",
            "COMPLETE",
            "PARTIAL",
            "ERROR"
          ]
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
          "format": "date-time"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "expected_host_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 66,
            "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "scope_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
        },
        "coverage_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "target_id",
        "identity_scope",
        "host_state",
        "reason_code",
        "inventory_authority_id",
        "identity_key"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])",
              "allOf": [
                {
                  "not": {
                    "pattern": "[/\\\\]"
                  }
                },
                {
                  "not": {
                    "enum": [
                      ".",
                      ".."
                    ]
                  }
                },
                {
                  "pattern": "\\S"
                },
                {
                  "not": {
                    "pattern": "^(?:[A-Za-z]:|[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|[Ff][Tt][Pp]:|[Ss][Ss][Hh]:|[Ss][Mm][Bb]:|[Dd][Aa][Tt][Aa]:)"
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_scope": {
          "type": "string",
          "enum": [
            "STABLE",
            "RUN_SCOPED"
          ]
        },
        "host_state": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "ERROR",
            "UNREACHABLE",
            "NOT_ATTEMPTED"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
        },
        "inventory_authority_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])",
              "allOf": [
                {
                  "not": {
                    "pattern": "[/\\\\]"
                  }
                },
                {
                  "not": {
                    "enum": [
                      ".",
                      ".."
                    ]
                  }
                },
                {
                  "pattern": "\\S"
                },
                {
                  "not": {
                    "pattern": "^(?:[A-Za-z]:|[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|[Ff][Tt][Pp]:|[Ss][Ss][Hh]:|[Ss][Mm][Bb]:|[Dd][Aa][Tt][Aa]:)"
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_scope": {
                "const": "STABLE"
              }
            },
            "required": [
              "identity_scope"
            ]
          },
          "then": {
            "properties": {
              "target_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])",
                "allOf": [
                  {
                    "not": {
                      "pattern": "[/\\\\]"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        ".",
                        ".."
                      ]
                    }
                  },
                  {
                    "pattern": "\\S"
                  },
                  {
                    "not": {
                      "pattern": "^(?:[A-Za-z]:|[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|[Ff][Tt][Pp]:|[Ss][Ss][Hh]:|[Ss][Mm][Bb]:|[Dd][Aa][Tt][Aa]:)"
                    }
                  }
                ]
              },
              "inventory_authority_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
              },
              "identity_key": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity_scope": {
                "const": "RUN_SCOPED"
              }
            },
            "required": [
              "identity_scope"
            ]
          },
          "then": {
            "properties": {
              "inventory_authority_id": {
                "type": "null"
              },
              "identity_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])",
                "allOf": [
                  {
                    "not": {
                      "pattern": "[/\\\\]"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        ".",
                        ".."
                      ]
                    }
                  },
                  {
                    "pattern": "\\S"
                  },
                  {
                    "not": {
                      "pattern": "^(?:[A-Za-z]:|[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|[Ff][Tt][Pp]:|[Ss][Ss][Hh]:|[Ss][Mm][Bb]:|[Dd][Aa][Tt][Aa]:)"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_id",
        "host_id",
        "collector_id",
        "collector_version",
        "scope_key",
        "collection_state",
        "reason_code",
        "source",
        "observed_at",
        "evidence_ids"
      ],
      "properties": {
        "collection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:c-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "collector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "collector_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])",
          "allOf": [
            {
              "not": {
                "pattern": "[/\\\\]"
              }
            },
            {
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            },
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "^(?:[A-Za-z]:|[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|[Ff][Tt][Pp]:|[Ss][Ss][Hh]:|[Ss][Mm][Bb]:|[Dd][Aa][Tt][Aa]:)"
              }
            }
          ]
        },
        "collection_state": {
          "type": "string",
          "enum": [
            "COLLECTED",
            "PARTIAL",
            "UNKNOWN",
            "NOT_SCANNED",
            "NOT_APPLICABLE",
            "PERMISSION_DENIED",
            "ERROR",
            "UNREACHABLE"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 66,
            "pattern": "^(?:e-[0-9a-f]{64})$(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "host_id",
        "asset_kind",
        "identity_scope",
        "identity_key",
        "evidence_ids"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:a-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "asset_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[a-z][a-z0-9_-]{0,63})$(?![\\s\\S])"
        },
        "identity_scope": {
          "type": "string",
          "enum": [
            "STABLE",
            "RUN_SCOPED"
          ]
        },
        "identity_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])",
          "allOf": [
            {
              "not": {
                "pattern": "[/\\\\]"
              }
            },
            {
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            },
            {
              "pattern": "\\S"
            },
            {
              "not": {
                "pattern": "^(?:[A-Za-z]:|[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|[Ff][Tt][Pp]:|[Ss][Ss][Hh]:|[Ss][Mm][Bb]:|[Dd][Aa][Tt][Aa]:)"
              }
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 66,
            "pattern": "^(?:e-[0-9a-f]{64})$(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      }
    },
    "negotiation_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "service_asset_id",
        "endpoint_ref",
        "protocol",
        "context_ref",
        "authorization_ref"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "service_asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:a-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "endpoint_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "TLS",
            "SSH"
          ]
        },
        "context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        }
      }
    },
    "usage_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "service_asset_id",
        "business_source_ref",
        "method",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "service_asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 66,
          "pattern": "^(?:a-[0-9a-f]{64})$(?![\\s\\S])"
        },
        "business_source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "method": {
          "type": "string",
          "enum": [
            "APPLICATION_TELEMETRY",
            "PASSIVE_SESSION_OBSERVATION",
            "SERVICE_AUDIT_RECORD"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
          "format": "date-time"
        }
      }
    },
    "platform_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_family",
        "os_version"
      ],
      "properties": {
        "os_family": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "os_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "package_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "present"
      ],
      "properties": {
        "name": {
          "type": "string",
