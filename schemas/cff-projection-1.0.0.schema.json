{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pqc:cff-projection:1.0.0",
  "title": "PQC local CFF projection and required companion (not an upstream CFF certification)",
  "type": "object",
  "properties": {
    "projection_version": {
      "const": "1.0.0"
    },
    "per_host": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host_projection"
      },
      "maxItems": 1000
    },
    "evidence_document_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
    }
  },
  "required": [
    "projection_version",
    "per_host",
    "evidence_document_sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 66,
      "pattern": "^(?:h-[0-9a-f]{64})$(?![\\s\\S])"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 66,
      "pattern": "^(?:a-[0-9a-f]{64})$(?![\\s\\S])"
    },
    "collection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 66,
      "pattern": "^(?:c-[0-9a-f]{64})$(?![\\s\\S])"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 66,
      "pattern": "^(?:e-[0-9a-f]{64})$(?![\\s\\S])"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 67,
      "pattern": "^(?:cl-[0-9a-f]{64})$(?![\\s\\S])"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 66,
      "pattern": "^(?:f-[0-9a-f]{64})$(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "NATIVE_COLLECTOR",
            "LEGACY_IMPORT",
            "SYNTHETIC"
          ]
        },
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "producer_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "input_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_kind",
        "producer_id",
        "producer_version",
        "origin_ref",
        "input_sha256"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "host_id": {
          "$ref": "#/$defs/host_id"
        },
        "asset_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/asset_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "host_id",
        "asset_id",
        "algorithm_id"
      ],
      "additionalProperties": false
    },
    "negotiation_conditions": {
      "type": "object",
      "properties": {
        "host_id": {
          "$ref": "#/$defs/host_id"
        },
        "service_asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "endpoint_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "TLS",
            "SSH"
          ]
        },
        "context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        }
      },
      "required": [
        "host_id",
        "service_asset_id",
        "endpoint_ref",
        "protocol",
        "context_ref",
        "authorization_ref"
      ],
      "additionalProperties": false
    },
    "usage_conditions": {
      "type": "object",
      "properties": {
        "host_id": {
          "$ref": "#/$defs/host_id"
        },
        "service_asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "business_source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "method": {
          "type": "string",
          "enum": [
            "APPLICATION_TELEMETRY",
            "PASSIVE_SESSION_OBSERVATION",
            "SERVICE_AUDIT_RECORD"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
          "format": "date-time"
        }
      },
      "required": [
        "host_id",
        "service_asset_id",
        "business_source_ref",
        "method",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "algorithm": {
      "type": "object",
      "properties": {
        "algorithm_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "type": "string",
          "enum": [
            "CLASSICAL",
            "PQC",
            "HYBRID",
            "UNKNOWN"
          ]
        },
        "primitive": {
          "type": "string",
          "enum": [
            "KEM",
            "KEX",
            "SIGNATURE",
            "PUBLIC_KEY",
            "SYMMETRIC",
            "UNKNOWN"
          ]
        },
        "taxonomy_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_name_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "migration_classification": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "LEGACY_PQC_REVIEW",
            "SYMMETRIC_REVIEW",
            "CLASSICAL_PUBLIC_KEY_MIGRATION",
            "PQC_OR_HYBRID_INVENTORY"
          ]
        }
      },
      "required": [
        "algorithm_id",
        "family",
        "primitive",
        "taxonomy_version",
        "observed_name_sha256",
        "migration_classification"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,63})$(?![\\s\\S])"
        },
        "run_state": {
          "type": "string",
          "enum": [
            "PLANNED",
            "COMPLETE",
            "PARTIAL",
            "ERROR"
          ]
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
          "format": "date-time"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "scope_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_kind": {
          "type": "string",
          "enum": [
            "RUN_FINISHED_AT",
            "RUN_RECORDED_AT"
          ]
        },
        "expected_host_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "run_id",
        "run_state",
        "recorded_at",
        "started_at",
        "finished_at",
        "source",
        "scope_reason",
        "coverage_reason",
        "timestamp_kind",
        "expected_host_count"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "host_id": {
          "$ref": "#/$defs/host_id"
        },
        "host_state": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "ERROR",
            "UNREACHABLE",
            "NOT_ATTEMPTED"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
        },
        "identity_scope": {
          "type": "string",
          "enum": [
            "STABLE",
            "RUN_SCOPED"
          ]
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,511})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,511})$(?![\\s\\S])"
        },
        "expected": {
          "const": true
        }
      },
      "required": [
        "host_id",
        "host_state",
        "reason_code",
        "identity_scope",
        "target_id",
        "display_host",
        "expected"
      ],
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "properties": {
        "collection_id": {
          "$ref": "#/$defs/collection_id"
        },
        "host_id": {
          "$ref": "#/$defs/host_id"
        },
        "collector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "collector_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "collection_state": {
          "type": "string",
          "enum": [
            "COLLECTED",
            "PARTIAL",
            "UNKNOWN",
            "NOT_SCANNED",
            "NOT_APPLICABLE",
            "PERMISSION_DENIED",
            "ERROR",
            "UNREACHABLE"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "maxItems": 20000,
          "uniqueItems": true
        },
        "scope_key_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        }
      },
      "required": [
        "collection_id",
        "host_id",
        "collector_id",
        "collector_version",
        "collection_state",
        "reason_code",
        "source",
        "observed_at",
        "evidence_ids",
        "scope_key_sha256"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "host_id": {
          "$ref": "#/$defs/host_id"
        },
        "asset_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[a-z][a-z0-9_-]{0,63})$(?![\\s\\S])"
        },
        "identity_scope": {
          "type": "string",
          "enum": [
            "STABLE",
            "RUN_SCOPED"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "maxItems": 20000,
          "uniqueItems": true
        }
      },
      "required": [
        "asset_id",
        "host_id",
        "asset_kind",
        "identity_scope",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "evidence_link": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidence_id"
        },
        "host_id": {
          "$ref": "#/$defs/host_id"
        },
        "collection_id": {
          "$ref": "#/$defs/collection_id"
        },
        "asset_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/asset_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "PLATFORM_INFO",
            "PACKAGE_INVENTORY",
            "RUNTIME_CAPABILITY",
            "EFFECTIVE_CONFIGURATION",
            "AUTHORIZED_NEGOTIATION",
            "OBSERVED_USAGE",
            "ASSET_METADATA",
            "COLLECTION_SUMMARY",
            "LEGACY_OBSERVATION",
            "TOOL_AVAILABILITY"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|\\+00:00))$(?![\\s\\S])",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm": {
          "anyOf": [
            {
              "$ref": "#/$defs/algorithm"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "oneOf": [
            {
              "$ref": "#/$defs/negotiation_conditions"
            },
            {
              "$ref": "#/$defs/usage_conditions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidence_id",
        "host_id",
        "collection_id",
        "asset_id",
        "evidence_kind",
        "source",
        "observed_at",
        "evidence_ref",
        "raw_sha256",
        "algorithm",
        "conditions"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "AUTHORIZED_NEGOTIATION"
              }
            }
          },
          "then": {
            "properties": {
              "conditions": {
                "$ref": "#/$defs/negotiation_conditions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "OBSERVED_USAGE"
              }
            }
          },
          "then": {
            "properties": {
              "conditions": {
                "$ref": "#/$defs/usage_conditions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "not": {
                  "enum": [
                    "AUTHORIZED_NEGOTIATION",
                    "OBSERVED_USAGE"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "conditions": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "level": {
          "type": "string",
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$(?![\\s\\S])"
        },
        "rule_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.+-]{0,127})$(?![\\s\\S])"
        },
        "assessment_state": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "PARTIAL",
            "UNKNOWN",
            "NOT_SCANNED",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?:[A-Z][A-Z0-9_]{0,95})$(?![\\s\\S])"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "maxItems": 20000,
          "uniqueItems": true
        },
        "conditions": {
          "oneOf": [
            {
              "$ref": "#/$defs/negotiation_conditions"
            },
            {
              "$ref": "#/$defs/usage_conditions"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim_key_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
