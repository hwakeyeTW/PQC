<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}PQC Report Portal{% endblock %}</title>
  <link rel="stylesheet" href="portal.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="masthead">
  <div class="wrap"><p class="brand">PQC Report Portal</p>
  <nav aria-label="Breadcrumb">Reports / <span aria-current="page">{{ v.run.run_id }}</span></nav></div>
</header>
<main id="main" class="wrap">
{% block content %}{% endblock %}
</main>
<footer class="wrap footer">Private, offline report. Keep the complete published run and its relative paths together. Not a release acceptance or a security score.</footer>
</body>
</html>
