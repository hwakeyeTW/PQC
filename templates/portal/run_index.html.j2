{% extends "base.html.j2" %}
{% macro value(x) -%}{% if x is none %}Unknown / not recorded{% elif x is sameas true %}Yes{% elif x is sameas false %}No{% else %}{{ x }}{% endif %}{%- endmacro %}
{% macro count_cards(items, prefix) -%}
<dl class="cards">{% for state, n in items %}<div class="metric"><dt>{{ state }}</dt><dd id="{{ prefix }}-{{ state }}">{{ n }}</dd></div>{% endfor %}</dl>
{%- endmacro %}
{% macro observations(rows, columns, ident) -%}
{% if rows %}<div class="scroll"><table id="{{ ident }}"><thead><tr><th scope="col">Family</th><th scope="col">Primitive</th>{% for name in columns %}<th scope="col">{{ name }}</th>{% endfor %}<th scope="col">Total</th></tr></thead><tbody>
{% for row in rows %}<tr><th scope="row">{{ row.family }}</th><td>{{ row.primitive }}</td>{% for n in row.counts %}<td>{{ n }}</td>{% endfor %}<td>{{ row.total }}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="empty" id="{{ ident }}-empty">No observations recorded. Capability or negotiation is unknown, not a negative result.</p>{% endif %}
{%- endmacro %}
{% block title %}Run {{ v.run.run_id }} | PQC Report Portal{% endblock %}
{% block content %}
<section class="hero" aria-labelledby="overview-title">
  <p class="eyebrow">Batch dashboard &middot; {{ v.run.run_kind }}</p>
  <h1 id="overview-title">Run {{ v.run.run_id }}</h1>
  <p><span class="pill">{{ v.run.publication_state }}</span> <strong id="run-state">{{ v.run.run_state }}</strong> &middot; {{ v.run.reason_code }}{% if v.run.recovery %} &middot; Recovered publication{% endif %}</p>
  <p>Publication confirms stored artifacts, not PQC readiness. Historical run catalog is not yet available.</p>
  <nav class="jump" aria-label="Run sections"><a href="#hosts">Hosts</a>{% if portal_v2|default(false) %}<a href="portal-v2/hosts.html">Host list</a>{% endif %}<a href="#coverage">Coverage</a><a href="#capability">Runtime</a><a href="#negotiation">Negotiation</a><a href="#assessment">Assessment</a><a href="#artifacts">Artifacts</a></nav>
</section>
<section aria-labelledby="metadata-heading"><h2 id="metadata-heading">Run metadata</h2>
<dl class="metadata">
{% for label, item in [('Source kind', v.run.source.source_kind), ('Producer', v.run.source.producer_id), ('Producer version', v.run.source.producer_version), ('Origin reference', v.run.source.origin_ref), ('Source SHA-256', v.run.source.input_sha256), ('Recorded (UTC)', v.run.recorded_at), ('Started (UTC)', v.run.started_at), ('Finished (UTC)', v.run.finished_at), ('Profile', v.run.profile), ('Evidence schema', v.run.evidence_schema_version), ('Rule version', v.run.rule_version), ('Rules SHA-256', v.run.rules_sha256), ('Batch contract', v.run.batch_contract), ('Batch rc', v.run.batch_rc), ('Recovery', v.run.recovery)] %}
<div><dt>{{ label }}</dt><dd>{{ value(item) }}</dd></div>{% endfor %}
</dl>{% if v.run.batch_missing_reason %}<p class="empty">Batch gap: {{ v.run.batch_missing_reason }}</p>{% endif %}
</section>
<section id="hosts" aria-labelledby="hosts-title"><h2 id="hosts-title">Host outcomes</h2>
<p><strong id="expected-hosts">{{ v.expected }}</strong> expected hosts. Execution state and attempt status are independent of assessment.</p>
{{ count_cards(v.host_counts, 'host') }}
<div class="scroll"><table id="host-rows"><thead><tr><th scope="col">Target / Host ID</th><th scope="col">State</th><th scope="col">Reason</th><th scope="col">Attempt status</th><th scope="col">Attempted</th><th scope="col">Dispatch intent</th><th scope="col">Recorded collections</th></tr></thead><tbody>
{% for h in v.hosts %}<tr id="{{ h.host_id }}"><th scope="row">{% if portal_v2|default(false) %}<a href="portal-v2/{{ h.host_id }}.html">{{ value(h.target_id) }}</a>{% else %}{{ value(h.target_id) }}{% endif %}<small>{{ h.host_id }}</small></th><td>{{ h.host_state }}</td><td>{{ h.reason_code }}</td><td>{{ h.attempt_status }}</td><td>{% if h.attempt_status == 'NOT_APPLICABLE' %}Not applicable{% else %}{{ value(h.attempted) }}{% endif %}</td><td>{% if h.attempt_status == 'NOT_APPLICABLE' %}Not applicable{% else %}{{ value(h.dispatch_intent) }}{% endif %}</td><td>{{ h.scopes }}</td></tr>{% endfor %}
</tbody></table></div></section>
<section id="coverage" aria-labelledby="coverage-title"><h2 id="coverage-title">Collection coverage</h2>
<p><strong id="collection-total">{{ v.collection_total }}</strong> recorded collection scopes. This denominator is recorded collections, not all expected scopes or a readiness percentage.</p>
{% if not v.collection_total %}<p class="empty">No collection scopes recorded; coverage is unknown.</p>{% endif %}
{{ count_cards(v.coverage, 'collection') }}
{% if v.gaps %}<h3>Recorded gaps and applicability</h3><div class="scroll"><table id="gap-rows"><thead><tr><th scope="col">State</th><th scope="col">Reason</th><th scope="col">Scopes</th></tr></thead><tbody>{% for state, reason, n in v.gaps %}<tr><td>{{ state }}</td><td>{{ reason }}</td><td>{{ n }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
<h3>Requested collectors and terminal outcomes</h3>
{% if not v.flags_known %}<p class="empty">Requested flags and native terminal outcomes are not recorded (legacy import); do not infer disabled or not attempted.</p>{% else %}<div class="scroll"><table id="collector-rows"><thead><tr><th scope="col">Host</th><th scope="col">Collector</th><th scope="col">Requested</th><th scope="col">Terminal state</th><th scope="col">Reason</th><th scope="col">rc</th><th scope="col">Collection refs</th></tr></thead><tbody>
{% for c in v.collectors %}<tr><td><a href="#{{ c.host_id }}">{{ value(c.target_id) }}</a></td><th scope="row">{{ c.collector }}</th><td>{{ value(c.requested) }}</td><td>{{ value(c.state) }}</td><td>{{ value(c.reason) }}</td><td>{{ value(c.rc) }}</td><td>{{ value(c.scopes) }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}</section>
<section id="capability" aria-labelledby="runtime-title"><h2 id="runtime-title">Runtime capability &middot; L2</h2><p>Recorded runtime observations by stored algorithm family and primitive. Installed packages, FIPS mode and algorithm names do not establish runtime support or negotiation.</p>
{{ observations(v.runtime, ['SUPPORTED', 'UNSUPPORTED', 'UNKNOWN'], 'runtime-observations') }}
</section>
<section id="negotiation" aria-labelledby="negotiation-title"><h2 id="negotiation-title">Service negotiation &middot; L4</h2><p>Recorded authorized negotiation outcomes under their original conditions. A supported algorithm, configured list or TLS cipher suite does not establish a negotiated key exchange or actual business use.</p>
{{ observations(v.negotiation, ['NEGOTIATED', 'REJECTED', 'UNKNOWN', 'ERROR', 'TIMEOUT'], 'negotiation-observations') }}
</section>
<section id="assessment" aria-labelledby="assessment-title"><h2 id="assessment-title">Published assessment</h2>
<h3>Algorithm classification inventory</h3><p>Counts of algorithm-bearing observations in the recorded taxonomy, not unique algorithms, hosts or readiness.</p>
{% if v.algorithm_counts %}<div class="scroll"><table id="algorithm-counts"><thead><tr><th scope="col">Family</th><th scope="col">Primitive</th><th scope="col">Observations</th></tr></thead><tbody>{% for family, primitive, n in v.algorithm_counts %}<tr><td>{{ family }}</td><td>{{ primitive }}</td><td>{{ n }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty">No algorithm classifications recorded.</p>{% endif %}
<p>L1-L5 are independent evidence levels, not a maturity ladder. These are counts of stored claims and findings, not a new evaluation.</p>
{% if not v.assessed %}<p class="empty" id="not-assessed">Not assessed / assessed artifact missing. No verdicts inferred.</p>{% else %}
<p>{{ v.claim_total }} recorded claims; {{ v.finding_total }} recorded findings.</p>
{% if not v.claim_total %}<p class="empty">No claims recorded.</p>{% endif %}
<div class="scroll"><table id="claim-counts"><thead><tr><th scope="col">Evidence level</th>{% for state in v.assessment_states %}<th scope="col">{{ state }}</th>{% endfor %}<th scope="col">Total</th></tr></thead><tbody>{% for row in v.levels %}<tr id="claims-{{ row.level }}"><th scope="row">{{ row.level }} {{ row.label }}</th>{% for n in row.counts %}<td>{{ n }}</td>{% endfor %}<td>{{ row.total }}</td></tr>{% endfor %}</tbody></table></div>
<h3>Finding states</h3>{% if not v.finding_total %}<p class="empty">No findings recorded; no verdict implied.</p>{% endif %}{{ count_cards(v.findings, 'finding') }}
{% endif %}</section>
<section id="artifacts" aria-labelledby="artifact-title"><h2 id="artifact-title">Published artifacts</h2><p>Only verified present artifacts have links. {% if portal_v2|default(false) %}Run-wide files are batch-level; host pages also link their present details. History and CBOM pages are not available in this slice.{% else %}The history entry and detailed Portal pages belong to later work packages.{% endif %}</p>
<div class="scroll"><table id="artifact-rows"><thead><tr><th scope="col">Artifact</th><th scope="col">Relative path</th><th scope="col">Version</th><th scope="col">Bytes</th></tr></thead><tbody>{% for item in v.links %}<tr><th scope="row">{{ item.label }}</th><td><a href="{{ item.path }}">{{ item.path }}</a></td><td>{{ item.version }}</td><td>{{ item.size }}</td></tr>{% endfor %}</tbody></table></div>
<h3>Missing required artifacts</h3>{% if v.missing %}<ul id="missing-artifacts">{% for item in v.missing %}<li>{{ item.path }} &mdash; {{ item.reason_code }}</li>{% endfor %}</ul>{% else %}<p>No required artifact gaps recorded. This is not a security PASS.</p>{% endif %}
{% if v.optional_missing %}<p class="empty">Not present (not required): {{ v.optional_missing | join(', ') }}.</p>{% endif %}</section>
{% endblock %}
