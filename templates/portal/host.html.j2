{% extends "base.html.j2" %}
{% macro value(x) -%}{% if x is none %}Unknown / not recorded{% elif x is sameas true %}Yes{% elif x is sameas false %}No{% else %}{{ x }}{% endif %}{%- endmacro %}
{% macro refs(ids) -%}{% for id in ids %}<a href="#{{ id }}">{{ id }}</a>{% if not loop.last %}<br>{% endif %}{% else %}None recorded{% endfor %}{%- endmacro %}
{% macro subject(s) -%}{{ s.host_id }}{% if s.asset_id|default(none) %}<br>{{ refs([s.asset_id]) }}{% endif %}{% if s.algorithm_id|default(none) %}<br>{{ s.algorithm_id }}{% endif %}{%- endmacro %}
{% macro source(s) -%}{{ s.source_kind }} / {{ s.producer_id }} / {{ value(s.producer_version) }}<small>Origin: {{ s.origin_ref }}; SHA-256: {{ value(s.input_sha256) }}</small>{%- endmacro %}
{% block title %}Host {{ host.host_id }} | Run {{ v.run.run_id }}{% endblock %}
{% block content %}
<section class="hero" id="{{ host.host_id }}"><p class="eyebrow">{{ v.run.run_kind }} &middot; {{ v.run.publication_state }}{% if v.run.recovery %} &middot; Recovered{% endif %}</p><h1>{{ value(host.target_id) }}</h1><p>{{ host.host_id }}</p><p><strong id="host-state">{{ host.host_state }}</strong> &middot; {{ host.reason_code }}</p>
<nav class="jump" aria-label="Host navigation"><a href="../index.html#{{ host.host_id }}">Back to batch</a><a href="hosts.html#{{ host.host_id }}">Host list</a>{% if host.previous %}<a rel="prev" href="{{ host.previous.host_id }}.html">Previous: {{ value(host.previous.target_id) }}</a>{% else %}<span>First host</span>{% endif %}{% if host.next %}<a rel="next" href="{{ host.next.host_id }}.html">Next: {{ value(host.next.target_id) }}</a>{% else %}<span>Last host</span>{% endif %}</nav>
<nav class="jump" aria-label="Host sections">{% for s in host.sections %}<a href="#{{ s.key }}">{{ s.title }}</a>{% endfor %}<a href="#assessment">Assessment</a><a href="#artifacts">Artifacts</a></nav>
</section>
<section><h2>Host outcome and collection coverage</h2><dl class="metadata">{% for label,item in [('Attempt status',host.attempt_status),('Attempted','Not applicable' if host.attempt_status == 'NOT_APPLICABLE' else host.attempted),('Dispatch intent','Not applicable' if host.attempt_status == 'NOT_APPLICABLE' else host.dispatch_intent),('Recorded at (UTC)',v.run.recorded_at),('Started at (UTC)',v.run.started_at),('Finished at (UTC)',v.run.finished_at),('Evidence schema',v.run.evidence_schema_version),('Rule version',v.run.rule_version),('Rules SHA-256',v.run.rules_sha256)] %}<div><dt>{{ label }}</dt><dd>{{ value(item) }}</dd></div>{% endfor %}<div><dt>Run source</dt><dd>{{ source(v.run.source) }}</dd></div></dl>
<p>{{ host.scopes }} recorded scopes, not an all-expected coverage or readiness score.</p>{% if not host.scopes %}<p class="empty">No collections recorded; coverage unknown.</p>{% endif %}<dl class="cards">{% for state,n in host.coverage %}<div class="metric"><dt>{{ state }}</dt><dd id="scope-{{ state }}">{{ n }}</dd></div>{% endfor %}</dl>
{% if host.collectors %}<h3>Requested and terminal collectors</h3><div class="scroll"><table id="host-collectors"><thead><tr><th>Collector</th><th>Requested</th><th>State</th><th>Reason</th><th>rc</th><th>Recorded scopes</th></tr></thead><tbody>{% for c in host.collectors %}<tr><td>{{ c.collector }}</td><td>{{ value(c.requested) }}</td><td>{{ value(c.state) }}</td><td>{{ value(c.reason) }}</td><td>{{ value(c.rc) }}</td><td>{{ value(c.scopes) }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty">Requested flags or terminal results not recorded.</p>{% endif %}</section>
{% for s in host.sections %}<section id="{{ s.key }}"><h2>{{ s.title }}</h2>
{% if s.key == 'runtime' %}<p>L2 runtime capability is not L4 service negotiation. TLS groups advertised by a runtime are not negotiated services.</p>{% elif s.key == 'policy' %}<p>FIPS / configuration evidence is independent of PQC readiness.</p>{% elif s.key == 'tls' or s.key == 'ssh' %}<p>Only authorized negotiation observations and saved L4 claims describe negotiation; legacy observations, configuration, cipher suites and client/runtime capabilities are not negotiation proof.</p>{% endif %}
{% if not s.collections and not s.assets and not s.evidence %}<p class="empty">No observations recorded in this section; unknown or not scanned, not a negative verdict.</p>{% endif %}
{% if s.collections %}<h3>Recorded collections</h3><div class="scroll"><table id="{{ s.key }}-collections"><thead><tr><th>Collection / scope</th><th>State / reason</th><th>Source / observed</th><th>Evidence</th></tr></thead><tbody>{% for c in s.collections %}<tr id="{{ c.collection_id }}"><th>{{ c.collector_id }} / {{ c.scope_key }}<small>{{ c.collection_id }}</small></th><td>{{ c.collection_state }}<br>{{ c.reason_code }}</td><td>{{ source(c.source) }}<br>{{ value(c.observed_at) }}</td><td>{{ refs(c.evidence_ids) }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% if s.assets %}<h3>Assets</h3><div class="scroll"><table id="{{ s.key }}-assets"><thead><tr><th>Asset</th><th>Identity scope</th><th>Evidence</th></tr></thead><tbody>{% for a in s.assets %}<tr id="{{ a.asset_id }}"><th>{{ a.asset_kind }}<small>{{ a.asset_id }}</small>{{ a.identity_key }}</th><td>{{ a.identity_scope }}</td><td>{{ refs(a.evidence_ids) }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% if s.evidence %}<h3>Typed evidence</h3><div class="scroll"><table id="{{ s.key }}-evidence"><thead><tr><th>Evidence / type</th><th>Recorded values</th><th>Algorithm</th><th>Source / observed</th><th>References</th></tr></thead><tbody>{% for r in s.evidence %}<tr id="{{ r.evidence_id }}"><th>{{ r.evidence_kind }}<small>{{ r.evidence_id }}</small>{% if r.evidence_kind == 'RUNTIME_CAPABILITY' %}L2 observation{% elif r.evidence_kind == 'AUTHORIZED_NEGOTIATION' %}L4 observation{% elif r.evidence_kind == 'LEGACY_OBSERVATION' %}Legacy / unverified observation{% endif %}</th><td>{% for key,item in r.facts %}{{ key }}: {{ value(item) }}<br>{% endfor %}</td><td>{% if r.algorithm %}{{ r.algorithm.family }} / {{ r.algorithm.primitive }}<br>{{ value(r.algorithm.algorithm_id) }}<br>{{ value(r.algorithm.observed_name) }}<br>Taxonomy: {{ value(r.algorithm.taxonomy_version) }}{% else %}Unknown / not recorded{% endif %}</td><td>{{ source(r.source) }}<br>{{ value(r.observed_at) }}{% if r.raw_sha256|default(none) %}<br>Raw SHA-256: {{ r.raw_sha256 }}{% endif %}{% if r.evidence_ref|default(none) %}<br>Opaque evidence reference: {{ r.evidence_ref }}{% endif %}</td><td>{{ refs([r.collection_id]) }}{% if r.asset_id %}<br>{{ refs([r.asset_id]) }}{% endif %}{% if r.evidence_kind in ('AUTHORIZED_NEGOTIATION', 'OBSERVED_USAGE') and r.data.conditions.service_asset_id != r.asset_id %}<br>{{ refs([r.data.conditions.service_asset_id]) }}{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
</section>{% endfor %}
<section id="assessment"><h2>Saved assessment / findings</h2><p>L1 Installed, L2 Supported (runtime), L3 Configured, L4 Negotiable (service), L5 Observed in use are independent, not an overall score.</p>
{% if not host.assessed %}<p class="empty" id="host-not-assessed">Assessment not present; no verdict inferred.</p>{% else %}
{% for level,label in [('L1','Installed'),('L2','Supported (runtime)'),('L3','Configured'),('L4','Negotiable (service)'),('L5','Observed in use')] %}<h3 id="host-{{ level }}">{{ level }} {{ label }}</h3>{% set claims = host.claims|selectattr('level','equalto',level)|list %}{% if claims %}<div class="scroll"><table id="claims-{{ level }}"><thead><tr><th>Claim</th><th>State / reason</th><th>Rule / subject</th><th>Evidence</th></tr></thead><tbody>{% for c in claims %}<tr id="{{ c.claim_id }}"><th>{{ c.claim_key }}<small>{{ c.claim_id }}</small></th><td>{{ c.assessment_state }}<br>{{ c.reason_code }}</td><td>{{ c.rule_id }} / {{ c.rule_version }}<br>{{ subject(c.subject) }}{% if c.conditions %}<br>{{ refs([c.conditions.service_asset_id]) }}{% for key in ('protocol','endpoint_ref','context_ref','authorization_ref') if c.level == 'L4' %}<br>{{ key }}: {{ c.conditions[key] }}{% endfor %}{% for key in ('method','business_source_ref','started_at','finished_at') if c.level == 'L5' %}<br>{{ key }}: {{ c.conditions[key] }}{% endfor %}{% endif %}</td><td>{{ refs(c.evidence_ids) }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty">No saved claims at this level; unknown.</p>{% endif %}{% endfor %}
<h3>Findings</h3>{% if host.findings %}<div class="scroll"><table id="host-findings"><thead><tr><th>Finding</th><th>State / reason</th><th>Rule / subject</th><th>Claims / evidence</th></tr></thead><tbody>{% for f in host.findings %}<tr id="{{ f.finding_id }}"><th>{{ f.condition_key }}<small>{{ f.finding_id }}</small></th><td>{{ f.assessment_state }}<br>{{ f.reason_code }}</td><td>{{ f.rule_id }} / {{ f.rule_version }}<br>{{ subject(f.subject) }}</td><td>{{ refs(f.claim_ids) }}<br>{{ refs(f.evidence_ids) }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty">No saved findings; no verdict implied.</p>{% endif %}{% endif %}</section>
<section id="artifacts"><h2>Verified artifacts</h2><h3>Host detail JSON</h3>{% if host.links %}<ul>{% for item in host.links %}<li><a href="{{ item.path }}">{{ item.label }} ({{ item.slot }})</a></li>{% endfor %}</ul>{% else %}<p class="empty">No host-specific detail JSON recorded.</p>{% endif %}{% for item in host.missing %}<p class="empty">Missing: {{ item.path }} / {{ item.reason_code }}</p>{% endfor %}
<h3>Batch-level files (not host-specific)</h3><ul>{% for item in host.run_links %}<li><a href="{{ item.path }}">{{ item.label }} (batch-wide)</a></li>{% endfor %}</ul>{% for item in host.run_missing %}<p class="empty">Missing: {{ item.path }} / {{ item.reason_code }}</p>{% endfor %}{% if host.optional_missing %}<p class="empty">Not present (not required): {{ host.optional_missing|join(', ') }}.</p>{% endif %}{% if v.run.run_kind == 'LEGACY_IMPORT' %}<p>Original legacy input bytes are not stored here; see the saved Evidence and provenance.</p>{% endif %}<p class="empty">CBOM not available in this published run. CFF is a different projection. Historical catalog is not yet available.</p></section>
{% endblock %}
