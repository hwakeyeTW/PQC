<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Findings | Run {{ p.run.run_id }}</title><link rel="stylesheet" href="../portal.css"></head>
<body><a class="skip" href="#main">Skip to content</a>
<header class="masthead"><div class="wrap"><p class="brand">PQC Report Portal</p><nav aria-label="Breadcrumb"><a href="../../index.html">History</a> / <a href="../index.html">{{ p.run.run_id }}</a> / {% if portal_v5 is defined and portal_v5 %}<span aria-current="page">Findings</span>{% else %}Findings{% endif %}</nav></div></header>
{% macro value(v) -%}{{ 'Unknown / not recorded' if v is none else v }}{%- endmacro %}
{% macro refs(ids, table) -%}{% for id in ids %}<a href="{{ table[id].href }}">{{ id }}</a>{% if not loop.last %}<br>{% endif %}{% else %}None recorded{% endfor %}{%- endmacro %}
<main class="wrap" id="main">
<section class="hero"><h1>Saved findings</h1><p>{{ p.run.run_kind }} / {{ p.run.run_state }} / {{ p.run.reason_code }}</p><p>Evidence schema: {{ p.run.evidence_schema_version }} / Rules: {{ value(p.run.rule_version) }}</p>
<p>L1 Installed, L2 Supported (runtime), L3 Configured, L4 Negotiable (service), L5 Observed in use are independent. No readiness score or new verdict is calculated.</p>{% if portal_v5 is defined and portal_v5 %}<nav class="jump" aria-label="Run sections"><a href="hosts.html">Hosts</a><a href="algorithms.html">Algorithms</a><a href="libraries.html">Libraries</a><a href="certificates.html">Certificates</a><a href="services.html">Services</a><span aria-current="page">Findings</span><a href="coverage.html">Coverage</a></nav>{% else %}<nav class="jump"><a href="hosts.html">Host list</a><a href="coverage.html">Coverage</a></nav>{% endif %}
{% if not p.assessed %}<p id="not-assessed" class="empty">Assessment not present; findings and assessed denominator unknown.</p>{% elif not p.findings %}<p id="empty-findings" class="empty">Saved assessment has no findings. This does not imply PASS.</p>{% else %}<p id="finding-total">{{ p.findings|length }} saved findings.</p>{% endif %}</section>
<section id="assessment-summary"><h2>Saved assessment and findings counts</h2><div class="scroll"><table id="assessment-metrics"><thead><tr><th>Metric</th><th>State</th><th>Count</th><th>Denominator</th></tr></thead><tbody>
{% for r in p.metrics if (r.dimension == 'finding' or (r.dimension == 'recorded' and r.metric in ['assessed_claims','L1','L2','L3','L4','L5'])) %}<tr><td>{{ r.metric }}</td><td>{{ value(r.state) }}</td><td>{{ value(r.count) }}</td><td>{{ value(r.denominator) }}</td></tr>{% endfor %}
</tbody></table></div></section>
{% if p.findings %}<section id="findings"><h2>Recorded findings</h2><div class="scroll"><table id="finding-records"><thead><tr><th>Finding</th><th>Subject</th><th>State / reason</th><th>Rule / version</th><th>Claims / evidence</th></tr></thead><tbody>
{% for id,f in p.findings|dictsort %}<tr id="{{ id }}"><th><a href="{{ f.href }}">{{ id }}</a><small>{{ f.condition_key }}</small></th><td><a href="{{ p.hosts[f.subject.host_id].href }}">{{ f.subject.host_id }}</a>{% if portal_v5 is defined and portal_v5 %}<br><a href="coverage.html#{{ p.hosts[f.subject.host_id].host_id }}">Host coverage</a>{% endif %}{% if f.subject.get('asset_id') %}<br><a href="{{ p.assets[f.subject.asset_id].href }}">{{ f.subject.asset_id }}</a>{% endif %}<br>Algorithm: {{ value(f.subject.get('algorithm_id')) }}</td><td>{{ f.assessment_state }} / {{ f.reason_code }}</td><td>{{ f.rule_id }} / {{ f.rule_version }}</td><td>{{ refs(f.claim_ids,p.claims) }}<br>{{ refs(f.evidence_ids,p.evidence) }}</td></tr>{% endfor %}
</tbody></table></div></section>{% endif %}
</main>{% if portal_v5 is defined and portal_v5 %}<footer class="wrap footer">Saved verified offline report. No new assessment or security score. Publication is integrated separately.</footer>{% else %}<footer class="wrap">PQC read-only summary preview. No new assessment or publication.</footer>{% endif %}</body></html>
